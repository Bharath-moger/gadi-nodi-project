NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
# Prefer 127.0.0.1 over "localhost" so server-side fetches match the API binding (IPv4) and avoid flaky ECONNREFUSED.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:4000/api
API_BASE_URL=http://127.0.0.1:4000/api
JWT_SECRET=replace-with-at-least-32-character-secret-key-for-production
NEXT_PUBLIC_CONTACT_EMAIL=hello@gadinodi.com
# Admin users are created by the API seed (see Web/API/gadinodi/.env.example SEED_DEMO_PASSWORD).
# After `npm run db:seed` in the API project, sign in at /login then open /admin/dashboard.
