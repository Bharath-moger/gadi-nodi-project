{
  "name": "gadinodi-api",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0 <23 || >=24.0.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "scripts": {
    "start:dev": "node --watch --watch-path=src --require ts-node/register src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:generate": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:wait": "node scripts/wait-for-db.mjs",
    "db:prepare": "npm run db:generate && npm run db:wait && npm run db:deploy && npm run db:seed",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@nestjs/common": "11.1.19",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.19",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "11.1.19",
    "@prisma/client": "6.8.2",
    "bcrypt": "^6.0.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "compression": "1.8.1",
    "dotenv": "17.4.2",
    "helmet": "8.1.0",
    "joi": "18.2.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "1.8.1",
    "@types/node": "25.6.2",
    "@types/passport-jwt": "^4.0.1",
    "prisma": "6.8.2",
    "ts-node": "10.9.2",
    "tsx": "4.21.0",
    "typescript": "6.0.3"
  }
}
